# Database (Supabase) — use the direct (non-pooled) connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Intervals API
INTERVALS_API_TOKEN="your-intervals-api-token"
INTERVALS_API_URL="https://api.myintervals.com"

# Resend (email)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="dashboard@yourdomain.com"

# Cron job protection
CRON_SECRET="generate-with: openssl rand -base64 32"
